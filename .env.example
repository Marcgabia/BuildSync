# Local PC: keep 127.0.0.1 / 3000 and open http://localhost:3000
# AWS EC2:  set APP_BIND_ADDRESS=0.0.0.0 and APP_PORT=80, then open http://<EC2-public-IP>
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=buildsync_db
DATABASE_USER=buildsync
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
