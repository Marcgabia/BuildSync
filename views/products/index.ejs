<%- include('../partials/header', { title: 'Products & inventory', activePage: 'products' }) %>
<main class="page-shell">
  <div class="page-heading">
    <div>
      <p class="eyebrow">CATALOG &amp; STOCK</p>
      <h1>Products &amp; inventory</h1>
      <p class="muted">Manage the product catalog, supplier assignments, prices, and stock levels.</p>
    </div>
    <div class="toolbar">
      <a class="button button-secondary" href="/products/categories">Categories</a>
      <% if (can('inventory.view', 'inventory.manage')) { %><a class="button button-secondary" href="/inventory">Stock movements</a><% } %>
      <% if (can('products.manage')) { %><a class="button button-primary" href="#add-product">Add product <span aria-hidden="true">＋</span></a><% } %>
    </div>
  </div>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>

  <section class="metric-grid">
    <article class="metric-card"><span class="metric-label">Products</span><strong><%= counts.total %></strong><span class="metric-note"><%= counts.active %> active</span></article>
    <article class="metric-card"><span class="metric-label">Low stock</span><strong class="<%= Number(counts.low_stock) ? 'text-danger' : '' %>"><%= counts.low_stock %></strong><a class="metric-link" href="/products?low=1">View low-stock items →</a></article>
    <article class="metric-card"><span class="metric-label">Categories</span><strong><%= categories.length %></strong><a class="metric-link" href="/products/categories">Manage categories →</a></article>
    <article class="metric-card metric-card-accent"><span class="metric-label">Stock value</span><strong><%= format.moneyShort(counts.stock_value) %></strong><span class="metric-note">On hand × unit price</span></article>
  </section>

  <section class="panel">
    <div class="section-heading">
      <div><p class="eyebrow">CATALOG</p><h2>Products <span class="count-badge"><%= pageInfo.total %></span></h2></div>
      <% if (can('reports.export')) { %><a class="button button-secondary button-small" href="/products/export.csv?q=<%= encodeURIComponent(filters.search) %>&amp;category=<%= filters.categoryId || '' %>&amp;status=<%= filters.status %><%= filters.lowStock ? '&amp;low=1' : '' %>">Export CSV</a><% } %>
    </div>
    <form class="filter-bar" action="/products" method="get" role="search">
      <label>Search<input type="search" name="q" value="<%= filters.search %>" placeholder="Name, SKU, description"></label>
      <label>Category<select name="category"><option value="">All categories</option><% categories.forEach((c) => { %><option value="<%= c.id %>" <%= filters.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label>
      <label>Status<select name="status"><option value="All">All statuses</option><% statuses.forEach((s) => { %><option <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
      <label class="check"><input type="checkbox" name="low" value="1" <%= filters.lowStock ? 'checked' : '' %>> Low stock only</label>
      <button class="button button-secondary" type="submit">Filter</button>
      <a class="text-link" href="/products">Clear</a>
    </form>
    <% if (products.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Product</th><th>Category</th><th>Supplier</th><th class="align-right">Unit price</th><th class="align-right">Stock</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead>
          <tbody>
            <% products.forEach((p) => { const low = Number(p.minimum_stock) > 0 && Number(p.current_stock) <= Number(p.minimum_stock); %>
              <tr>
                <td><a class="table-primary" href="/products/<%= p.id %>"><%= p.name %></a><span class="table-secondary"><%= p.product_code %> · per <%= p.unit %></span></td>
                <td><%= p.category_name %></td>
                <td><%= p.supplier_name || '—' %></td>
                <td class="align-right"><%= format.money(p.unit_price) %></td>
                <td class="align-right <%= low ? 'text-danger' : '' %>"><%= p.current_stock %><span class="table-secondary">min <%= p.minimum_stock %><%= low ? ' · LOW' : '' %></span></td>
                <td><%- include('../partials/status', { status: p.status }) %></td>
                <td class="supplier-actions"><a class="text-link" href="/products/<%= p.id %>">View</a><% if (can('products.manage')) { %><a class="text-link" href="/products/<%= p.id %>/edit">Edit</a><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/pagination', { pageInfo, basePath: '/products', params: { q: filters.search, category: filters.categoryId, status: filters.status, low: filters.lowStock ? '1' : '' }, noun: 'products' }) %>
    <% } else { %>
      <div class="empty-state"><span class="empty-icon" aria-hidden="true">＋</span><h3>No products found</h3><p><%= filters.search || filters.categoryId || filters.lowStock ? 'Try a different search or filter.' : 'Add your first product below.' %></p></div>
    <% } %>
  </section>

  <% if (can('products.manage')) { %>
  <section class="panel form-panel" id="add-product">
    <div class="section-heading"><div><p class="eyebrow">CATALOG</p><h2>Add a product</h2></div><span class="form-hint">Fields marked * are required</span></div>
    <% if (!categories.length) { %>
      <div class="notice-box"><p>Create a product category first.</p><a class="text-link" href="/products/categories">Go to categories →</a></div>
    <% } else { %>
    <form action="/products" method="post" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>SKU / product code *<input name="product_code" maxlength="60" required placeholder="e.g. CEM-40KG" value="<%= values.product_code || '' %>"></label>
      <label>Product name *<input name="name" maxlength="200" required value="<%= values.name || '' %>"></label>
      <label>Category *<select name="category_id" required><option value="">Choose a category</option><% categories.forEach((c) => { %><option value="<%= c.id %>" <%= String(values.category_id || '') === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label>
      <label>Supplier<select name="supplier_id"><option value="">No preferred supplier</option><% suppliers.forEach((s) => { %><option value="<%= s.id %>" <%= String(values.supplier_id || '') === String(s.id) ? 'selected' : '' %>><%= s.vendor_name %></option><% }) %></select></label>
      <label>Unit of measurement *<input name="unit" maxlength="30" required placeholder="e.g. bag, pc, meter" value="<%= values.unit || '' %>"></label>
      <label>Unit price (PHP) *<input name="unit_price" type="number" min="0" step="0.01" required value="<%= values.unit_price || '' %>"></label>
      <label>Opening stock<input name="opening_stock" type="number" min="0" step="1" value="<%= values.opening_stock || 0 %>"></label>
      <label>Minimum stock level<input name="minimum_stock" type="number" min="0" step="1" value="<%= values.minimum_stock || 0 %>"></label>
      <label>Status<select name="status"><% statuses.forEach((s) => { %><option <%= (values.status || 'Active') === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
      <label class="field-wide">Description<textarea name="description" rows="2" maxlength="5000"><%= values.description || '' %></textarea></label>
      <div class="form-actions field-wide"><button class="button button-primary" type="submit">Save product</button></div>
    </form>
    <% } %>
  </section>
  <% } %>
</main>
<%- include('../partials/footer') %>
