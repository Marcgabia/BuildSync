<%- include('../partials/header', { title: 'Inventory', activePage: 'products' }) %>
<main class="page-shell">
  <a class="back-link" href="/products">← Back to products</a>
  <div class="page-heading">
    <div><p class="eyebrow">INVENTORY</p><h1>Stock movements</h1><p class="muted">Every receipt and adjustment, with the resulting balance. Stock increases only when deliveries are confirmed.</p></div>
  </div>

  <section class="panel">
    <div class="section-heading"><div><p class="eyebrow">ATTENTION</p><h2>Low-stock products <span class="count-badge"><%= lowStock.length %></span></h2></div></div>
    <% if (lowStock.length) { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Product</th><th>Supplier</th><th class="align-right">On hand</th><th class="align-right">Minimum</th><th><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
          <% lowStock.forEach((p) => { %>
            <tr><td><a class="table-primary" href="/products/<%= p.id %>"><%= p.name %></a><span class="table-secondary"><%= p.product_code %></span></td><td><%= p.supplier_name || '—' %></td><td class="align-right text-danger"><%= p.current_stock %> <%= p.unit %></td><td class="align-right"><%= p.minimum_stock %></td>
              <td class="supplier-actions"><% if (can('requisitions.create')) { %><a class="text-link" href="/requisitions/new">Request stock</a><% } %></td></tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } else { %><p class="muted">No active product is at or below its minimum stock level.</p><% } %>
  </section>

  <section class="panel">
    <div class="section-heading"><div><p class="eyebrow">HISTORY</p><h2>Inventory transactions <span class="count-badge"><%= pageInfo.total %></span></h2></div></div>
    <form class="filter-bar" action="/inventory" method="get">
      <label>Product<input type="search" name="q" value="<%= filters.search %>" placeholder="Name or SKU"></label>
      <label>Type<select name="type"><option value="All">All types</option><% ['Opening', 'Receipt', 'Adjustment In', 'Adjustment Out'].forEach((t) => { %><option <%= filters.type === t ? 'selected' : '' %>><%= t %></option><% }) %></select></label>
      <label>From<input type="date" name="from" value="<%= filters.from %>"></label>
      <label>To<input type="date" name="to" value="<%= filters.to %>"></label>
      <button class="button button-secondary" type="submit">Filter</button>
      <a class="text-link" href="/inventory">Clear</a>
    </form>
    <% if (movements.length) { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Product</th><th>Type</th><th class="align-right">Quantity</th><th class="align-right">Balance</th><th>Reference</th><th>By</th><th>Notes</th></tr></thead>
        <tbody>
          <% movements.forEach((m) => { %>
            <tr>
              <td><%= format.dateTime(m.created_at) %></td>
              <td><a class="table-primary" href="/products/<%= m.product_id %>"><%= m.product_name %></a><span class="table-secondary"><%= m.product_code %></span></td>
              <td><%= m.transaction_type %></td>
              <td class="align-right <%= m.quantity < 0 ? 'text-danger' : 'text-good' %>"><%= m.quantity > 0 ? '+' : '' %><%= m.quantity %></td>
              <td class="align-right"><%= m.balance_after %></td>
              <td><%= m.reference_type ? `${m.reference_type} #${m.reference_id}` : '—' %></td>
              <td><%= m.user_name || '—' %></td>
              <td><%= m.notes || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
      <%- include('../partials/pagination', { pageInfo, basePath: '/inventory', params: { q: filters.search, type: filters.type, from: filters.from, to: filters.to }, noun: 'movements' }) %>
    <% } else { %><div class="empty-state"><p>No inventory movements match these filters.</p></div><% } %>
  </section>
</main>
<%- include('../partials/footer') %>
