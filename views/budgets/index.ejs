<%- include('../partials/header', { title: 'Budget management', activePage: 'budgets' }) %>
<main class="page-shell">
  <div class="page-heading">
    <div>
      <p class="eyebrow">FINANCE</p>
      <h1>Budget management</h1>
      <p class="muted">Approved orders commit budget; accepted deliveries convert commitments into actual spending; cancellations release commitments.</p>
    </div>
    <div class="toolbar">
      <% if (can('reports.export')) { %><a class="button button-secondary" href="/budgets/export.csv?department=<%= filters.departmentId || '' %>&amp;year=<%= filters.year || '' %>&amp;status=<%= filters.status %>">Export CSV</a><% } %>
      <% if (can('budgets.manage')) { %><a class="button button-primary" href="#add-budget">New budget <span aria-hidden="true">＋</span></a><% } %>
    </div>
  </div>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>

  <% if (totals) { %>
  <section class="metric-grid">
    <article class="metric-card"><span class="metric-label">Allocated</span><strong><%= format.moneyShort(totals.allocated) %></strong><span class="metric-note">Budgets shown below</span></article>
    <article class="metric-card"><span class="metric-label">Committed</span><strong><%= format.moneyShort(totals.committed) %></strong><span class="metric-note">Approved orders not yet received</span></article>
    <article class="metric-card"><span class="metric-label">Actual spending</span><strong><%= format.moneyShort(totals.actual) %></strong><span class="metric-note">Accepted goods received</span></article>
    <article class="metric-card metric-card-accent"><span class="metric-label">Remaining</span><strong class="<%= totals.remaining < 0 ? 'text-danger' : '' %>"><%= format.moneyShort(totals.remaining) %></strong><span class="metric-note">Allocated − committed − actual</span></article>
  </section>
  <% } %>

  <section class="panel">
    <form class="filter-bar" action="/budgets" method="get">
      <label>Department<select name="department"><option value="">All departments</option><% departments.forEach((d) => { %><option value="<%= d.id %>" <%= filters.departmentId === d.id ? 'selected' : '' %>><%= d.name %></option><% }) %></select></label>
      <label>Year<select name="year"><option value="">All years</option><% years.forEach((y) => { %><option <%= filters.year === y ? 'selected' : '' %>><%= y %></option><% }) %></select></label>
      <label>Status<select name="status"><option value="All">All statuses</option><% statuses.forEach((s) => { %><option <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
      <button class="button button-secondary" type="submit">Filter</button>
      <a class="text-link" href="/budgets">Clear</a>
    </form>
    <% if (budgets.length) { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Budget</th><th>Period</th><th class="align-right">Allocated</th><th class="align-right">Committed</th><th class="align-right">Actual</th><th class="align-right">Remaining</th><th>Utilization</th><th>Status</th></tr></thead>
        <tbody>
          <% budgets.forEach((b) => { %>
            <tr>
              <td><a class="table-primary" href="/budgets/<%= b.id %>"><%= b.name %></a><span class="table-secondary"><%= b.department_name %></span></td>
              <td><%= b.period_type %><span class="table-secondary"><%= b.period_start %> – <%= b.period_end %></span></td>
              <td class="align-right"><%= format.money(b.allocated_amount) %></td>
              <td class="align-right"><%= format.money(b.committed_amount) %></td>
              <td class="align-right"><%= format.money(b.actual_amount) %></td>
              <td class="align-right <%= b.remaining_amount < 0 ? 'text-danger' : '' %>"><%= format.money(b.remaining_amount) %></td>
              <td><%= b.utilization.toFixed(1) %>%<%- include('../partials/meter', { percent: b.utilization, threshold: b.warning_threshold }) %></td>
              <td><%- include('../partials/status', { status: b.status }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } else { %>
      <div class="empty-state"><span class="empty-icon" aria-hidden="true">₱</span><h3>No budgets yet</h3><p>Create an annual or monthly budget for a department to track commitments and spending.</p></div>
    <% } %>
  </section>

  <% if (can('budgets.manage')) { %>
  <section class="panel form-panel" id="add-budget">
    <div class="section-heading"><div><p class="eyebrow">ALLOCATION</p><h2>Create a budget</h2></div><span class="form-hint">One budget per department and period</span></div>
    <form action="/budgets" method="post" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/budget-form-fields', { values, departments, statuses }) %>
      <div class="form-actions field-wide"><button class="button button-primary" type="submit">Create budget</button></div>
    </form>
  </section>
  <% } %>
</main>
<%- include('../partials/footer') %>
