<%
  // Utilization meter. Expects: percent, threshold
  const pct = Math.max(0, Number(percent) || 0);
  const tone = pct >= 100 ? 'critical' : pct >= Number(threshold || 80) ? 'warning' : '';
%><svg class="meter" viewBox="0 0 100 8" preserveAspectRatio="none" role="img" aria-label="<%= pct.toFixed(1) %>% used"><rect class="track" x="0" y="0" width="100" height="8" rx="4"></rect><rect class="fill <%= tone %>" x="0" y="0" width="<%= Math.min(pct, 100).toFixed(1) %>" height="8" rx="4"></rect></svg>
