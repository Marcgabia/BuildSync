<%
  // Password field with a working Show/Hide toggle.
  // Params: id, name, label, autocomplete, placeholder, minlength, hint, wide, ariaOnly (no visible label)
  const fieldId = id;
  const isRequired = locals.required !== false;
%><div class="field<%= locals.wide ? ' field-wide' : '' %>">
  <% if (!locals.ariaOnly) { %><label for="<%= fieldId %>"><%= label %></label><% } %>
  <div class="password-field">
    <input id="<%= fieldId %>" name="<%= name %>" type="password" maxlength="200"
      <% if (locals.minlength) { %>minlength="<%= minlength %>"<% } %>
      autocomplete="<%= locals.autocomplete || 'current-password' %>"
      <% if (locals.placeholder) { %>placeholder="<%= placeholder %>"<% } %>
      <% if (locals.ariaOnly) { %>aria-label="<%= label %>"<% } %>
      <%= isRequired ? 'required' : '' %>>
    <button class="password-toggle js-toggle-password" type="button" aria-controls="<%= fieldId %>" aria-pressed="false" aria-label="Show password">
      <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
      <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M10.6 5.6A9.9 9.9 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-3 3.8M6.3 6.8C3.9 8.5 2.5 12 2.5 12S6 18.5 12 18.5c1.6 0 3-.4 4.2-1M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg>
      <span class="js-toggle-label">Show</span>
    </button>
  </div>
  <% if (locals.hint) { %><span class="password-hint"><%= hint %></span><% } %>
</div>
