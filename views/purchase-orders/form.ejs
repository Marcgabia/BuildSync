<%- include('../partials/header', { title: order ? `Edit ${order.po_number}` : 'New purchase order', activePage: 'purchase-orders' }) %>
<main class="page-shell">
  <a class="back-link" href="<%= order ? `/purchase-orders/${order.id}` : '/purchase-orders' %>">← Back</a>
  <div class="page-heading">
    <div>
      <p class="eyebrow">PURCHASE ORDER</p>
      <h1><%= order ? `Edit ${order.po_number}` : 'New purchase order' %></h1>
      <p class="muted"><%= requisition ? `Converting approved requisition ${requisition.requisition_number} (${requisition.department_name}).` : 'Add products, choose the supplier, and set the expected delivery date. Totals are recalculated on the server.' %></p>
    </div>
  </div>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>

  <% if (!order && !requisition && requisitions.length) { %>
    <section class="panel">
      <div class="inline-fields">
        <label class="filter-bar">Start from an approved requisition
          <select data-navigate="/purchase-orders/new?requisition=">
            <option value="">Choose a requisition…</option>
            <% requisitions.forEach((r) => { %><option value="<%= r.id %>"><%= r.requisition_number %> · <%= r.department_name %> · <%= format.money(r.total_estimated) %></option><% }) %>
          </select>
        </label>
      </div>
    </section>
  <% } %>

  <% if (!suppliers.length || !products.length) { %>
    <section class="panel notice-box">
      <p><%= !suppliers.length ? 'Add or activate a supplier' : 'Add a product to the catalog' %> before creating a purchase order.</p>
      <a class="text-link" href="<%= !suppliers.length ? '/suppliers#add-supplier' : '/products#add-product' %>">Go there →</a>
    </section>
  <% } else { %>
  <form action="<%= order ? `/purchase-orders/${order.id}/edit` : '/purchase-orders' %>" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (requisition) { %><input type="hidden" name="requisition_id" value="<%= requisition.id %>"><% } %>
    <section class="panel">
      <div class="section-heading"><div><p class="eyebrow">ORDER DETAILS</p><h2>Supplier and schedule</h2></div></div>
      <div class="form-grid">
        <label>PO number<input name="po_number" maxlength="50" placeholder="Leave blank to auto-generate" value="<%= values.po_number || '' %>"></label>
        <label>Supplier *
          <select name="supplier_id" required>
            <option value="">Choose an active supplier</option>
            <% suppliers.forEach((s) => { %><option value="<%= s.id %>" <%= String(values.supplier_id || '') === String(s.id) ? 'selected' : '' %>><%= s.vendor_name %> · <%= s.supplier_code %></option><% }) %>
          </select>
        </label>
        <label>Department (budget)
          <select name="department_id" <%= requisition || (order && order.requisition_id) ? 'disabled' : '' %>>
            <option value="">No department budget</option>
            <% departments.forEach((d) => { %><option value="<%= d.id %>" <%= String(values.department_id || '') === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
          </select>
        </label>
        <label>Order date *<input name="order_date" type="date" required value="<%= values.order_date || '' %>"></label>
        <label>Expected delivery date *<input name="target_date" type="date" required value="<%= values.target_date || '' %>"></label>
        <label>Notes<input name="notes" maxlength="5000" value="<%= values.notes || '' %>"></label>
      </div>
    </section>

    <section class="panel">
      <div class="section-heading"><div><p class="eyebrow">LINE ITEMS</p><h2>Products</h2></div></div>
      <%- include('../partials/line-items', { products, items, priceLabel: 'Unit price' }) %>
      <div class="form-grid">
        <label>Discount amount (PHP)<input name="discount_amount" type="number" min="0" step="0.01" value="<%= values.discount_amount === undefined ? '0.00' : values.discount_amount %>"></label>
        <label>Tax rate (%)<input name="tax_rate" type="number" min="0" max="50" step="0.01" value="<%= values.tax_rate === undefined ? defaultTaxRate : values.tax_rate %>"></label>
      </div>
      <div class="totals-box js-totals" aria-live="polite">
        <div><span>Subtotal</span><span data-total="subtotal">₱0.00</span></div>
        <div><span>Discount</span><span data-total="discount">₱0.00</span></div>
        <div><span>Tax</span><span data-total="tax">₱0.00</span></div>
        <div class="grand"><span>Total</span><span data-total="total">₱0.00</span></div>
      </div>
    </section>

    <div class="form-actions panel">
      <a class="button button-secondary" href="<%= order ? `/purchase-orders/${order.id}` : '/purchase-orders' %>">Cancel</a>
      <button class="button button-secondary" type="submit" name="intent" value="draft">Save as draft</button>
      <button class="button button-primary" type="submit" name="intent" value="submit">Save and submit for approval</button>
    </div>
  </form>
  <% } %>
</main>
<%- include('../partials/footer') %>
