<!doctype html>
<html lang="en"<% if (locals.theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111827">
  <title>Create an account · BuildSync Procurement</title>
  <link rel="stylesheet" href="/styles.css?v=5">
</head>
<body class="auth-body">
  <%- include('../partials/theme-toggle', { floating: true }) %>
  <div class="auth-split">
    <%- include('_brand') %>
    <main class="auth-main">
      <section class="auth-card">
        <span class="brand auth-mobile-brand"><span class="brand-mark" aria-hidden="true">B</span><span>BuildSync<span class="brand-light"> Procurement</span></span></span>
        <p class="eyebrow">Get started</p>
        <h1>Create an account</h1>
        <p class="muted"><%= mode === 'open' ? 'Register to start requesting materials right away.' : 'Register to request access. An administrator reviews new accounts before you can sign in.' %></p>
        <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
        <form action="/register" method="post" class="form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Full name<input name="full_name" maxlength="150" autocomplete="name" required value="<%= values.full_name || '' %>" placeholder="Juan Dela Cruz" autofocus></label>
          <label>Work email<input name="email" type="email" maxlength="254" autocomplete="username" required value="<%= values.email || '' %>" placeholder="you@company.com"></label>
          <label>Department
            <select name="department_id" required>
              <option value="">Choose your department</option>
              <% departments.forEach((d) => { %><option value="<%= d.id %>" <%= String(values.department_id || '') === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
            </select>
          </label>
          <%- include('../partials/password-input', { id: 'register-password', name: 'password', label: 'Password', autocomplete: 'new-password', minlength: 10, placeholder: 'At least 10 characters', hint: 'Use 10+ characters with at least one letter and one number.' }) %>
          <%- include('../partials/password-input', { id: 'register-password-confirm', name: 'password_confirmation', label: 'Confirm password', autocomplete: 'new-password', minlength: 10, placeholder: 'Repeat your password' }) %>
          <label class="check"><input type="checkbox" name="terms" value="accepted" required> <span>I am an employee requesting access to BuildSync. New accounts start with requester access; an administrator can assign other roles.</span></label>
          <div class="form-actions"><button class="button button-primary" type="submit">Create account</button></div>
        </form>
        <p class="auth-switch">Already have an account? <a class="text-link" href="/login">Sign in</a></p>
      </section>
    </main>
  </div>
  <script src="/app.js?v=5" defer></script>
</body>
</html>
