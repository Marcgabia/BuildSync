<!doctype html>
<html lang="en"<% if (locals.theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111827">
  <title> BuildSync </title>
  <link rel="stylesheet" href="/styles.css?v=5">
</head>
<body class="auth-body">
  <%- include('../partials/theme-toggle', { floating: true }) %>
  <div class="auth-split">
    <%- include('_brand') %>
    <main class="auth-main">
      <section class="auth-card">
        <span class="brand auth-mobile-brand"><span class="brand-mark" aria-hidden="true">B</span><span>BuildSync<span class="brand-light"> Procurement</span></span></span>
        <p class="eyebrow">Welcome back</p>
        <h1>Sign in to your account</h1>
        <p class="muted">Enter your work email and password to continue.</p>
        <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
        <% if (locals.notice) { %><div class="alert alert-success" role="status"><%= notice %></div><% } %>
        <form action="/login" method="post" class="form-grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="next" value="<%= next %>">
          <label>Email address<input name="email" type="email" autocomplete="username" maxlength="254" required value="<%= email %>" placeholder="you@company.com" autofocus></label>
          <%- include('../partials/password-input', { id: 'login-password', name: 'password', label: 'Password', autocomplete: 'current-password', placeholder: 'Your password' }) %>
          <div class="form-actions"><button class="button button-primary" type="submit">Sign in</button></div>
        </form>
        <% if (locals.registrationEnabled) { %>
          <p class="auth-switch">Don't have an account? <a class="text-link" href="/register">Create an account</a></p>
        <% } else { %>
          <p class="auth-switch">Need access? Ask an administrator to create your account.</p>
        <% } %>
      </section>
    </main>
  </div>
  <script src="/app.js?v=5" defer></script>
</body>
</html>
