<%- include('partials/header', { title: 'Suppliers', activePage: 'suppliers' }) %>
<% const can = typeof locals.can === 'function' ? locals.can : () => true;
   const canManage = can('suppliers.manage');
   const statusFilter = locals.status || 'All';
   const page = locals.page || 1, totalPages = locals.totalPages || 1, total = locals.total === undefined ? suppliers.length : locals.total;
   const statusList = locals.statuses || ['Active', 'Pending Qualification', 'Inactive']; %>
<main class="page-shell">
  <div class="page-heading">
    <div>
      <p class="eyebrow">VENDOR DIRECTORY</p>
      <h1>Suppliers</h1>
      <p class="muted">Keep supplier contacts, terms, qualification status, and performance up to date.</p>
    </div>
    <% if (canManage) { %><a class="button button-primary" href="#add-supplier">Add supplier <span aria-hidden="true">＋</span></a><% } %>
  </div>

  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
  <% if (suppliers.length) { %>
    <section class="panel">
      <div class="section-heading section-heading-stack">
        <div>
          <p class="eyebrow">YOUR NETWORK</p>
          <h2>Supplier directory <span class="count-badge"><%= total %></span></h2>
        </div>
        <form class="search-form supplier-filters" action="/suppliers" method="get" role="search">
          <label class="sr-only" for="supplier-search">Search suppliers</label>
          <input id="supplier-search" type="search" name="q" value="<%= search %>" placeholder="Search name, code, category">
          <label class="sr-only" for="supplier-status">Filter by status</label>
          <select id="supplier-status" name="status">
            <% ['All', ...statusList].forEach((supplierStatus) => { %>
              <option value="<%= supplierStatus %>" <%= statusFilter === supplierStatus ? 'selected' : '' %>><%= supplierStatus === 'All' ? 'All statuses' : supplierStatus %></option>
            <% }) %>
          </select>
          <button class="button button-secondary" type="submit">Filter</button>
          <% if (search || statusFilter !== 'All') { %><a class="text-link" href="/suppliers">Clear</a><% } %>
        </form>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Supplier</th><th>Category</th><th>Contact</th><th>Terms</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr>
          </thead>
          <tbody>
            <% suppliers.forEach((supplier) => { %>
              <tr>
                <td><span class="table-primary"><%= supplier.vendor_name %></span><span class="table-secondary"><%= supplier.supplier_code %><%= supplier.tax_id ? ` · TIN ${supplier.tax_id}` : '' %></span></td>
                <td><%= supplier.material_category %></td>
                <td><span><%= supplier.key_account_manager %></span><span class="table-secondary"><%= supplier.email %></span></td>
                <td><%= supplier.credit_terms %> days<span class="table-secondary"><%= supplier.delivery_lead_time %> day lead</span></td>
                <td><span class="status-pill <%= supplier.status === 'Active' ? 'status-active' : supplier.status === 'Inactive' ? 'status-inactive' : 'status-pending' %>"><%= supplier.status %></span></td>
                <td class="supplier-actions">
                  <a class="text-link" href="/suppliers/<%= supplier.id %>">View</a>
                  <% if (canManage) { %>
                    <a class="text-link" href="/suppliers/<%= supplier.id %>/edit">Edit</a>
                    <% if (supplier.status !== 'Inactive') { %>
                      <form action="/suppliers/<%= supplier.id %>/deactivate" method="post" class="inline-form js-confirm" data-confirm="Deactivate this supplier? Its purchase history will be preserved.">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="text-button text-button-danger" type="submit">Deactivate</button>
                      </form>
                    <% } else { %>
                      <form action="/suppliers/<%= supplier.id %>/activate" method="post" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="text-button" type="submit">Activate</button>
                      </form>
                    <% } %>
                    <form action="/suppliers/<%= supplier.id %>/delete" method="post" class="inline-form js-confirm" data-confirm="Permanently delete this supplier? This is only allowed when it has no orders, deliveries, or products.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="text-button text-button-danger" type="submit">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (totalPages > 1) { %>
        <nav class="pagination" aria-label="Supplier directory pages">
          <% if (page > 1) { %>
            <a class="button button-secondary button-small" href="/suppliers?q=<%= encodeURIComponent(search) %>&amp;status=<%= encodeURIComponent(statusFilter) %>&amp;page=<%= page - 1 %>">Previous</a>
          <% } else { %>
            <span class="button button-secondary button-small" aria-disabled="true">Previous</span>
          <% } %>
          <span>Page <%= page %> of <%= totalPages %> · <%= total %> suppliers</span>
          <% if (page < totalPages) { %>
            <a class="button button-secondary button-small" href="/suppliers?q=<%= encodeURIComponent(search) %>&amp;status=<%= encodeURIComponent(statusFilter) %>&amp;page=<%= page + 1 %>">Next</a>
          <% } else { %>
            <span class="button button-secondary button-small" aria-disabled="true">Next</span>
          <% } %>
        </nav>
      <% } %>
    </section>
  <% } else if (search || statusFilter !== 'All') { %>
    <section class="panel empty-state">
      <span class="empty-icon" aria-hidden="true">⌕</span>
      <h2>No matching suppliers</h2>
      <p>Try another search or status filter.</p>
      <a class="button button-secondary" href="/suppliers">Clear search</a>
    </section>
  <% } else { %>
    <section class="panel empty-state">
      <span class="empty-icon" aria-hidden="true">＋</span>
      <h2>No suppliers yet</h2>
      <p>Add your first vendor below to start creating purchase orders.</p>
    </section>
  <% } %>

  <% if (canManage) { %>
  <section class="panel form-panel" id="add-supplier">
    <div class="section-heading">
      <div><p class="eyebrow">BUILD YOUR NETWORK</p><h2>Add a supplier</h2></div>
      <span class="form-hint">Fields marked * are required</span>
    </div>
    <form action="/suppliers/add" method="post" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Supplier code *<input name="supplier_code" maxlength="50" required placeholder="e.g. SUP-001" value="<%= formValues.supplier_code || '' %>"></label>
      <label>Supplier name *<input name="vendor_name" maxlength="255" required placeholder="Business name" value="<%= formValues.vendor_name || '' %>"></label>
      <label>Contact person *<input name="key_account_manager" maxlength="255" required placeholder="Account manager" value="<%= formValues.key_account_manager || '' %>"></label>
      <label>Phone number *<input name="contact_number" maxlength="50" required placeholder="+63 9xx xxx xxxx" value="<%= formValues.contact_number || '' %>"></label>
      <label>Email address *<input name="email" type="email" maxlength="255" required placeholder="name@company.com" value="<%= formValues.email || '' %>"></label>
      <label>Tax identification number<input name="tax_id" maxlength="50" placeholder="Optional" value="<%= formValues.tax_id || '' %>"></label>
      <label>Supplier category *<input name="material_category" maxlength="255" required placeholder="e.g. Electrical" value="<%= formValues.material_category || '' %>"></label>
      <label>Service reliability rating
        <select name="reliability_rating">
          <option value="">Not rated yet</option>
          <% [5, 4, 3, 2, 1].forEach((r) => { %><option value="<%= r %>" <%= String(formValues.reliability_rating || '') === String(r) ? 'selected' : '' %>><%= r %> / 5</option><% }) %>
        </select>
      </label>
      <label>Credit terms (days) *<input name="credit_terms" type="number" min="0" step="1" required value="<%= formValues.credit_terms === undefined ? 30 : formValues.credit_terms %>"></label>
      <label>Delivery lead time (days) *<input name="delivery_lead_time" type="number" min="0" step="1" required value="<%= formValues.delivery_lead_time === undefined ? 7 : formValues.delivery_lead_time %>"></label>
      <label class="field-wide">Business address *<textarea name="warehouse_address" rows="3" required placeholder="Complete business / warehouse address"><%= formValues.warehouse_address || '' %></textarea></label>
      <div class="form-actions field-wide"><button class="button button-primary" type="submit">Save supplier</button></div>
    </form>
  </section>
  <% } %>
</main>
<%- include('partials/footer') %>
